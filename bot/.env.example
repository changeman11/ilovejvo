# I<3JVO pickup bot settings.
# Copy this file to `.env` (same folder) and fill it in. `.env` is git-ignored: it never goes
# into the repo. Never paste the token or password into chat.

# ---- Discord (BOT-SETUP.md, Parts 1-3) ----
# SECRET. Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=
# Turn on Developer Mode in Discord (User Settings -> Advanced), then right-click -> Copy ID.
GUILD_ID=
# The voice channel players join to ready up.
QUEUE_CHANNEL_ID=
# The text channel where the bot posts the queue, drafts and game cards.
PICKUP_CHANNEL_ID=
# Optional: the category for the team voice channels (default: the ready-up channel's category).
TEAM_CATEGORY_ID=
# Optional: role IDs (comma separated) that count as pickup admins. Anyone with
# "Manage Server" is an admin anyway.
ADMIN_ROLE_IDS=

# ---- Where ratings are kept ----
# file = a JSON file on this computer (data/pickup.json). Good for trying it out.
# firebase = the I<3JVO Firestore database (BOT-SETUP.md, Part 5), so the website can show it.
STORE=file
# For STORE=firebase. SECRET: the bot's own Firebase account password (letters and numbers only).
FIREBASE_BOT_EMAIL=pickup-bot@users.ilovejvo.com
FIREBASE_BOT_PASSWORD=
# 1 = use the local Firebase emulators (`npm run dev` in the repo folder) instead of the live site.
FIREBASE_EMULATOR=

# ---- Game settings (these are the defaults) ----
# Team sizes the random mode picks from.
MODES=2,3,4,5,6
# alternate (A B A B) or snake (A B B A).
DRAFT_ORDER=alternate
# Seconds to wait for more players once there are enough for a game.
COUNTDOWN_SECONDS=30
# Seconds a captain has for each pick before it's random.
PICK_SECONDS=60
ELO_START=1000
ELO_K=32

# 1 = allow /pickup testfill (pretend players, for testing alone). Turn off for real games.
ALLOW_TEST_PLAYERS=
