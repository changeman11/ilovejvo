# I<3JVO pickup bot settings.
# Copy this file to `.env` (same folder) and fill it in. `.env` is git-ignored: it never goes
# into the repo. Never paste the token or password into chat.

# ---- Discord (BOT-SETUP.md, Parts 1-3) ----
# SECRET. Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=
# Turn on Developer Mode in Discord (User Settings -> Advanced), then right-click -> Copy ID.
GUILD_ID=
# The text channel where the bot posts the queue card (with the Sign up / Withdraw menu),
# ready checks, drafts and game cards.
PICKUP_CHANNEL_ID=
# Optional: the category for the locked ready-up and team voice channels (default: the pickup
# text channel's category).
TEAM_CATEGORY_ID=
# Optional: role IDs (comma separated) that count as pickup admins. They can join the locked
# channels and get pinged when captains disagree. Anyone with "Manage Server" is an admin anyway.
ADMIN_ROLE_IDS=

# ---- Where ratings are kept ----
# file = a JSON file on this computer (data/pickup.json). Good for trying it out.
# firebase = the I<3JVO Firestore database (BOT-SETUP.md, Part 5), so the website can show it.
STORE=file
# For STORE=firebase. SECRET: the bot's own Firebase account password (letters and numbers only).
FIREBASE_BOT_EMAIL=pickup-bot@users.ilovejvo.com
FIREBASE_BOT_PASSWORD=
# 1 = use the local Firebase emulators (`npm run dev` in the repo folder) instead of the live site.
FIREBASE_EMULATOR=

# ---- Game settings (these are the defaults) ----
# Team sizes the random mode picks from.
MODES=2,3,4,5,6
# alternate (A B A B) or snake (A B B A).
DRAFT_ORDER=alternate
# Seconds to wait for more players once there are enough for a game.
COUNTDOWN_SECONDS=30
# Mode votes (the menu on the queue card) needed to pick the next mode; otherwise it's random.
MODE_VOTES_NEEDED=2
# Seconds picked players have to join their locked ready-up channel before they're replaced.
READY_SECONDS=60
# Seconds a captain has for each pick before it's random.
PICK_SECONDS=60
ELO_START=1000
ELO_K=32

# With STORE=firebase the queue is also on the website (sign up / withdraw there, live pickup
# page). 0 = turn that off.
SITE_QUEUE=
# The I<3JVO website, linked from the bot's messages (default https://i-love-jvo.web.app). 0 = no links.
SITE_URL=

# ---- Club roles ----
# 1 = give each I<3JVO club a cosmetic Discord role (club colour) and keep it on the club's players
# (matched by the Discord ID on their site profile). Needs the bot to have "Manage Roles".
CLUB_ROLES=
# 1 = club members show as their own group in the member list; 0 = not grouped.
CLUB_ROLES_GROUPED=1
# How often (minutes) to check the site for club changes. A full check also runs every 6 hours.
CLUB_ROLES_MINUTES=5

# 1 = allow /pickup testfill (pretend players, for testing alone). Turn off for real games.
ALLOW_TEST_PLAYERS=
