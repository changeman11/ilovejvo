rules_version = '2';

// I<3JVO security rules (Firebase free plan: no server code, so these rules are the guard).
//
// - The public can read PUBLISHED events, plus their fixtures, results and rosters,
//   and all teams and players. Drafts and their contents are admin-only.
// - Only admins can write. An admin is a signed-in user whose uid has a document in /admins.
//   Admin documents are added from the Firebase console, never from the website.
// - Every admin save is stamped with who and when (updatedBy / updatedAt = server time),
//   and writes an entry to /auditLog in the same step. Log entries can't be edited or deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function stampedByMe() {
      return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
    }

    function eventPublished(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.published == true;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.type in ['exhibition', 'tournament']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.status in ['upcoming', 'finished', 'cancelled']
          && d.published is bool
          && (d.date == null || d.date is timestamp)
          && d.teamIds is list && d.teamIds.size() <= 64;
    }

    function validResult() {
      let d = request.resource.data;
      return d.sets is list && d.sets.size() >= 1 && d.sets.size() <= 7
          && d.playerStats is map;
    }

    function validName(field) {
      let v = request.resource.data[field];
      return v is string && v.size() > 0 && v.size() <= 60;
    }

    // ---- Events (exhibition nights, tournaments) ----
    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && stampedByMe() && validEvent();
      allow delete: if isAdmin();

      match /results/{fixtureId} {
        allow read: if eventPublished(eventId) || isAdmin();
        allow create, update: if isAdmin() && stampedByMe() && validResult();
        allow delete: if isAdmin();
      }

      // fixtures, rosters
      match /{collection}/{docId} {
        allow read: if eventPublished(eventId) || isAdmin();
        allow create, update: if isAdmin() && stampedByMe() && collection in ['fixtures', 'rosters'];
        allow delete: if isAdmin() && collection in ['fixtures', 'rosters'];
      }
    }

    // ---- Teams and players (shared across events; stats add up over every event) ----
    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if isAdmin() && stampedByMe() && validName('name');
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin() && stampedByMe() && validName('displayName');
      allow delete: if isAdmin();
    }

    // ---- Site settings. Public. ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Who is an admin. A signed-in user may check their own entry only. ----
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- Audit log: append-only. Admins add entries signed with their own uid. ----
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.at == request.time
                    && request.resource.data.action in ['create', 'update', 'delete'];
      allow update, delete: if false;
    }

    // Everything else is closed.
  }
}
