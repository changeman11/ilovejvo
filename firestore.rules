rules_version = '2';

// I<3JVO security rules
// - The public can read PUBLISHED events (exhibition nights and tournaments). Drafts are admin-only.
// - League data (seasons, teams, players, cups) is ADMIN-ONLY for now. To open it to everyone
//   when the league launches, change leagueIsPublic() to return true.
// - Only authorised admins can write. An admin is a user whose uid has a document in /admins.
//   Admin documents are added from the Firebase console, never from the website.
// - The audit log and analytics are written by the server only.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- The switch for the league section ----
    function leagueIsPublic() {
      return false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function canReadLeague() {
      return leagueIsPublic() || isAdmin();
    }

    // Every admin save must say who made it and when, so the server-side audit log
    // can record it. Deletes are stamped just before they happen.
    function stampedByMe() {
      return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
    }

    function validResult() {
      let d = request.resource.data;
      return d.sets is list && d.sets.size() >= 1 && d.sets.size() <= 7
          && d.playerStats is map;
    }

    function validEvent() {
      let d = request.resource.data;
      return d.type in ['exhibition', 'tournament']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.status in ['upcoming', 'finished', 'cancelled']
          && d.published is bool
          && (d.date == null || d.date is timestamp);
    }

    // ---- Events: exhibition nights and tournaments ----
    // The public only sees published ones (the site asks for published == true).
    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && stampedByMe() && validEvent();
      allow delete: if isAdmin();
    }

    // ---- League data (admin-only until leagueIsPublic() is true) ----
    match /seasons/{seasonId} {
      allow read: if canReadLeague();
      allow create, update: if isAdmin() && stampedByMe();
      allow delete: if isAdmin();

      match /results/{fixtureId} {
        allow read: if canReadLeague();
        allow create, update: if isAdmin() && stampedByMe() && validResult();
        allow delete: if isAdmin();
      }

      match /fixtures/{fixtureId} {
        allow read: if canReadLeague();
        allow create, update: if isAdmin() && stampedByMe();
        allow delete: if isAdmin();
      }

      // rosters, transfers, awards, playoffs
      // (Firestore allows a write if ANY rule matches, so results/fixtures are excluded here.)
      match /{collection}/{docId} {
        allow read: if canReadLeague();
        allow write: if isAdmin() && !(collection in ['results', 'fixtures']);
      }
    }

    match /teams/{teamId} {
      allow read: if canReadLeague();
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if canReadLeague();
      allow write: if isAdmin();
    }

    match /cups/{document=**} {
      allow read: if canReadLeague();
      allow write: if isAdmin();
    }

    // Site name and links. Public.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Who is an admin. A signed-in user may check their own entry only.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Server-written only. Admins can read.
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anyone can report a front-end error (small, fixed shape). Nobody can edit them.
    match /clientErrors/{errorId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'url', 'userAgent', 'at'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 2000
                    && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() < 8000))
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Everything else is closed.
  }
}
