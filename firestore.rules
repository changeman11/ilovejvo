rules_version = '2';

// I<3JVO security rules (Firebase free plan: no server code, so these rules are the guard).
//
// Who's who:
// - Admins: signed-in users with a document in /admins (added in the Firebase console only).
// - Players: signed in with Discord (uid "discord:<id>"; the token carries discordId).
//   A player owns the profile whose `uid` is theirs.
// - Managers: the `managerUid` of an APPROVED team.
//
// What players and managers can do (everything else is admin-only):
// - Create their own profile (id "d<discordId>"), edit their name/number/bio.
// - Ask to claim an existing profile (/claims; an admin approves).
// - Register a team: it starts "pending" until an admin approves it.
// - Managers send offers to free agents and release players from their own team.
// - Players accept/decline offers (accepting is the only way to join a team themselves).
// - Players ask to leave their team (/leaveRequests; an admin approves).
//
// Every save is stamped with who and when (updatedBy / updatedAt = server time), and writes an
// /auditLog entry signed with the writer's own uid. Log entries can't be edited or deleted.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Admin powers need a password sign-in. Discord sign-ins use tokens from our Worker
    // ("custom" provider); if its signing key ever leaked, it still couldn't act as an admin.
    // A Discord sign-in only counts when its /admins entry is explicitly marked `discord: true`
    // (added by hand in the Firebase console for named people).
    function isAdmin() {
      return signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && (request.auth.token.firebase.sign_in_provider == 'password'
              || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('discord', false) == true);
    }
    function discordId() { return signedIn() ? request.auth.token.get('discordId', '') : ''; }
    function stampedByMe() {
      return request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function playerDoc(pid) { return get(/databases/$(database)/documents/players/$(pid)).data; }
    function teamDoc(tid) { return get(/databases/$(database)/documents/teams/$(tid)).data; }
    function ownsPlayer(pid) { return signedIn() && playerDoc(pid).get('uid', null) == request.auth.uid; }
    function managesTeam(tid) {
      return signedIn() && teamDoc(tid).get('managerUid', null) == request.auth.uid
          && teamDoc(tid).get('status', 'approved') == 'approved';
    }
    function eventPublished(eventId) { return get(/databases/$(database)/documents/events/$(eventId)).data.published == true; }
    function validName(field) {
      let v = request.resource.data[field];
      return v is string && v.size() > 0 && v.size() <= 60;
    }
    function validBio() {
      let d = request.resource.data;
      return !('bio' in d) || d.bio == null || (d.bio is string && d.bio.size() <= 1000);
    }
    // ---------- Profile customisation (teams and players) ----------
    // Optional text field up to `max` characters.
    function optText(field, max) {
      let d = request.resource.data;
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= max);
    }
    // Optional link: empty, or https://... up to 200 characters.
    function optLink(socials, key) {
      let v = socials.get(key, '');
      return v == null || v == '' || (v is string && v.size() <= 200 && v.matches('https://.+'));
    }
    // An uploaded image path must point at this team's/player's own folder, e.g. teams/abc/logo/x1.gif
    function optMedia(field, folder) {
      let d = request.resource.data;
      return !(field in d) || d[field] == null
          || (d[field] is string && d[field].matches(folder + '[A-Za-z0-9_-]+[.](png|jpg|webp|gif)'));
    }
    function validCustomise(base) {
      let d = request.resource.data;
      return optText('tagline', 80) && validBio()
          && (!('theme' in d) || d.theme == null || (d.theme is string && d.theme.matches('#[0-9a-fA-F]{6}')))
          && (!('showcase' in d) || d.showcase == null || (d.showcase is list && d.showcase.size() <= 4))
          && (!('socials' in d) || d.socials == null
              || (d.socials is map
                  && d.socials.keys().hasOnly(['discord', 'youtube', 'twitch', 'tiktok', 'x'])
                  && optLink(d.socials, 'discord') && optLink(d.socials, 'youtube') && optLink(d.socials, 'twitch')
                  && optLink(d.socials, 'tiktok') && optLink(d.socials, 'x')))
          && optMedia('bannerPath', base + '/banner/') && optMedia('backgroundPath', base + '/background/');
    }
    function validTeamProfile(teamId) {
      return validCustomise('teams/' + teamId) && optMedia('logoPath', 'teams/' + teamId + '/logo/');
    }
    function validPlayerProfile(playerId) {
      return validCustomise('players/' + playerId) && optMedia('avatarPath', 'players/' + playerId + '/avatar/');
    }
    function validEvent() {
      let d = request.resource.data;
      return d.type in ['exhibition', 'tournament']
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.status in ['upcoming', 'finished', 'cancelled']
          && d.published is bool
          && (d.date == null || d.date is timestamp)
          && d.teamIds is list && d.teamIds.size() <= 64;
    }
    function validResult() {
      let d = request.resource.data;
      return d.sets is list && d.sets.size() >= 1 && d.sets.size() <= 7 && d.playerStats is map;
    }
    function signupsOpen(eventId) {
      let e = get(/databases/$(database)/documents/events/$(eventId)).data;
      return e.published == true && e.get('signups', false) == true && e.status == 'upcoming'
          && e.get('fixturesLockedAt', null) == null
          && (e.get('date', null) == null || e.get('timeTbd', false) == true
              || request.time < e.date - duration.value(10, 'm'));
    }
    function fixtureDoc(eventId, fixtureId) { return get(/databases/$(database)/documents/events/$(eventId)/fixtures/$(fixtureId)).data; }
    // A vote as it will be after this save (so a vote and the result it completes can be saved together).
    function voteAfter(eventId, voteId) { return getAfter(/databases/$(database)/documents/events/$(eventId)/submissions/$(voteId)).data; }

    // A player's vote: they're signed in as that player, the player is on one of the two teams,
    // the event is public and the match has no result yet.
    function validVote(eventId, subId) {
      let d = request.resource.data;
      let f = fixtureDoc(eventId, d.fixtureId);
      return signedIn() && stampedByMe() && eventPublished(eventId)
          && subId == d.fixtureId + '__' + d.playerId
          && d.uid == uid() && ownsPlayer(d.playerId)
          && d.teamId == playerDoc(d.playerId).get('teamId', '')
          && (d.teamId == f.homeTeamId || d.teamId == f.awayTeamId)
          && !exists(/databases/$(database)/documents/events/$(eventId)/results/$(d.fixtureId))
          && d.sets is list && d.sets.size() >= 1 && d.sets.size() <= 7
          && d.playerStats is map && d.playerStats.size() <= 12
          && (!('screenshotPaths' in d) || (d.screenshotPaths is list && d.screenshotPaths.size() <= 3))
          && d.keys().hasOnly(['fixtureId', 'playerId', 'uid', 'teamId', 'sets', 'playerStats', 'screenshotPaths', 'createdAt', 'updatedBy', 'updatedAt']);
    }

    // A SCORE published by players: exactly the set scores one home-team vote and one away-team vote
    // agree on, written by one of the two voters. No stats or MVP: an admin adds those after checking
    // the screenshots (statsStatus 'pending').
    function agreedResult(eventId, fixtureId) {
      let d = request.resource.data;
      let f = fixtureDoc(eventId, fixtureId);
      let h = voteAfter(eventId, d.confirmedBy[0]);
      let a = voteAfter(eventId, d.confirmedBy[1]);
      return signedIn() && stampedByMe() && eventPublished(eventId) && validResult()
          && d.keys().hasOnly(['sets', 'playerStats', 'mvpPlayerId', 'forfeit', 'confirmedBy', 'source', 'statsStatus', 'enteredBy', 'enteredAt', 'updatedBy', 'updatedAt'])
          && d.confirmedBy is list && d.confirmedBy.size() == 2
          && h.fixtureId == fixtureId && a.fixtureId == fixtureId
          && h.teamId == f.homeTeamId && a.teamId == f.awayTeamId
          && (h.uid == uid() || a.uid == uid())
          && h.sets == d.sets && a.sets == d.sets
          && d.playerStats.size() == 0 && d.mvpPlayerId == null
          && d.statsStatus == 'pending' && d.forfeit == null;
    }

    // ---------- Events (exhibition nights, tournaments): admin-run ----------
    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && stampedByMe() && validEvent();
      allow delete: if isAdmin();

      match /results/{fixtureId} {
        allow read: if eventPublished(eventId) || isAdmin();
        allow create, update: if isAdmin() && stampedByMe() && validResult();
        // Players publish a result only when both teams have voted the same set scores (see agreedResult).
        allow create: if agreedResult(eventId, fixtureId);
        allow delete: if isAdmin();
      }

      // ---------- Result votes from players ----------
      // One per player per match (id "<fixtureId>__<playerId>"): the set scores they say happened, plus
      // their own team's stat lines. Anyone on either team may vote until a result exists.
      match /submissions/{subId} {
        allow read: if eventPublished(eventId) || isAdmin();
        allow create, update: if validVote(eventId, subId);
        allow delete: if isAdmin()
          || (signedIn() && resource.data.uid == uid()
              && !exists(/databases/$(database)/documents/events/$(eventId)/results/$(resource.data.fixtureId)));
      }
      // ---------- Club sign-ups (id = teamId) ----------
      // A club's manager signs it up or pulls it out while sign-ups are open: the event is public and
      // upcoming, sign-ups are switched on, the fixtures aren't locked, and it's more than 10 minutes
      // before the start (an event without a start time stays open until an admin locks it).
      match /entries/{teamId} {
        allow read: if eventPublished(eventId) || isAdmin();
        allow create: if signupsOpen(eventId) && managesTeam(teamId) && stampedByMe()
          && request.resource.data.keys().hasOnly(['teamId', 'managerUid', 'createdAt', 'updatedBy', 'updatedAt'])
          && request.resource.data.teamId == teamId && request.resource.data.managerUid == uid()
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin() || (signupsOpen(eventId) && managesTeam(teamId));
        allow create, update: if isAdmin() && stampedByMe();
      }

      match /{collection}/{docId} {
        allow read: if eventPublished(eventId) || isAdmin();
        allow create, update: if isAdmin() && stampedByMe() && collection in ['fixtures', 'rosters'];
        allow delete: if isAdmin() && collection in ['fixtures', 'rosters'];
      }
    }

    // ---------- Players ----------
    match /players/{playerId} {
      allow read: if true;

      allow create: if
        (isAdmin() && stampedByMe() && validName('displayName'))
        // A Discord user creates their own profile, one per Discord account, as a free agent.
        || (discordId() != '' && playerId == 'd' + discordId()
            && stampedByMe() && validName('displayName') && validBio()
            && request.resource.data.uid == uid()
            && request.resource.data.discordId == discordId()
            && request.resource.data.get('teamId', null) == null
            && request.resource.data.keys().hasOnly(['displayName', 'number', 'bio', 'uid', 'discordId', 'discordName', 'avatarUrl', 'teamId', 'active', 'updatedBy', 'updatedAt']));

      allow update: if
        (isAdmin() && stampedByMe() && validName('displayName'))
        // Owner edits and customises their own profile.
        || (signedIn() && resource.data.get('uid', null) == uid() && stampedByMe()
            && validName('displayName') && validPlayerProfile(playerId)
            && changedOnly(['displayName', 'number', 'bio', 'avatarUrl', 'discordName',
                            'tagline', 'theme', 'showcase', 'socials', 'avatarPath', 'bannerPath', 'backgroundPath',
                            'updatedBy', 'updatedAt']))
        // Owner joins a team, only by accepting a pending offer in the same save.
        || (signedIn() && resource.data.get('uid', null) == uid() && stampedByMe()
            && resource.data.get('teamId', null) == null
            && changedOnly(['teamId', 'joinOfferId', 'updatedBy', 'updatedAt'])
            && get(/databases/$(database)/documents/offers/$(request.resource.data.joinOfferId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.joinOfferId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.joinOfferId)).data.playerId == playerId
            && getAfter(/databases/$(database)/documents/offers/$(request.resource.data.joinOfferId)).data.teamId == request.resource.data.teamId)
        // A manager adds a free agent to their team, only by accepting that player's pending
        // join request in the same save.
        || (signedIn() && stampedByMe()
            && resource.data.get('teamId', null) == null
            && managesTeam(request.resource.data.teamId)
            && changedOnly(['teamId', 'joinRequestId', 'updatedBy', 'updatedAt'])
            && get(/databases/$(database)/documents/joinRequests/$(request.resource.data.joinRequestId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/joinRequests/$(request.resource.data.joinRequestId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/joinRequests/$(request.resource.data.joinRequestId)).data.playerId == playerId
            && getAfter(/databases/$(database)/documents/joinRequests/$(request.resource.data.joinRequestId)).data.teamId == request.resource.data.teamId)
        // A manager releases someone (not themselves) from their own team.
        || (signedIn() && stampedByMe()
            && resource.data.get('teamId', null) != null
            && managesTeam(resource.data.teamId)
            && resource.data.get('uid', null) != uid()
            && request.resource.data.teamId == null
            && changedOnly(['teamId', 'updatedBy', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ---------- Teams ----------
    match /teams/{teamId} {
      allow read: if true;

      allow create: if
        (isAdmin() && stampedByMe() && validName('name'))
        // A free-agent player registers a team. It waits for an admin.
        || (signedIn() && stampedByMe() && validName('name')
            && request.resource.data.status == 'pending'
            && request.resource.data.managerUid == uid()
            && ownsPlayer(request.resource.data.managerPlayerId)
            && playerDoc(request.resource.data.managerPlayerId).get('teamId', null) == null
            && request.resource.data.keys().hasOnly(['name', 'shortName', 'colors', 'status', 'managerUid', 'managerPlayerId', 'createdBy', 'updatedBy', 'updatedAt']));

      allow update: if
        (isAdmin() && stampedByMe() && validName('name'))
        // The manager edits and customises their approved team.
        || (managesTeam(teamId) && stampedByMe() && validName('name') && validTeamProfile(teamId)
            && changedOnly(['name', 'shortName', 'colors',
                            'tagline', 'bio', 'theme', 'showcase', 'socials', 'logoPath', 'bannerPath', 'backgroundPath',
                            'updatedBy', 'updatedAt']))
        // The manager hands the club over to another player in the squad (who has a Discord sign-in).
        || (managesTeam(teamId) && stampedByMe()
            && changedOnly(['managerUid', 'managerPlayerId', 'updatedBy', 'updatedAt'])
            && request.resource.data.managerUid is string
            && playerDoc(request.resource.data.managerPlayerId).get('teamId', '') == teamId
            && playerDoc(request.resource.data.managerPlayerId).get('uid', '') == request.resource.data.managerUid)
        // While waiting for approval, the person who registered it can add a logo and profile.
        || (signedIn() && resource.data.status == 'pending' && resource.data.managerUid == uid()
            && stampedByMe() && validTeamProfile(teamId)
            && changedOnly(['tagline', 'bio', 'theme', 'showcase', 'socials', 'logoPath', 'bannerPath', 'backgroundPath',
                            'updatedBy', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ---------- Chat: no slurs ----------
    // Same pattern as SEVERE_PATTERN in public/js/rules/profanity.js (a test checks they match).
    // Ordinary swearing is allowed and starred out on screen; slurs are refused here.
    function noSlurs(text) {
      return !text.lower().matches('(?s).*\\b(n+[i1!]+g{2,}(a|ah|as|az|er|ers|uh)?|f+[a@4]+g+([o0]+t+)?s?|r+[e3]+t+[a@4]+r+d+(s|ed)?|tr[a@4]nn(y|ies)|k[i1]kes?|ch[i1]nks?|sp[i1]cs?|c[o0][o0]ns?|g[o0][o0]ks?|wetbacks?)\\b.*');
    }

    // ---------- Global chat (the slide-out panel) ----------
    // Anyone can read. Players with a profile post as themselves: up to 300 characters, no slurs,
    // one message every 3 seconds (each post also stamps chatLimits/{uid} in the same save).
    // The writer and admins can delete.
    match /chat/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['body', 'authorUid', 'authorPlayerId', 'createdAt'])
        && request.resource.data.body is string && request.resource.data.body.trim().size() > 0
        && request.resource.data.body.size() <= 300
        && noSlurs(request.resource.data.body)
        && request.resource.data.authorUid == uid() && request.resource.data.createdAt == request.time
        && ownsPlayer(request.resource.data.authorPlayerId)
        && getAfter(/databases/$(database)/documents/chatLimits/$(uid())).data.lastAt == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == uid());
    }
    match /chatLimits/{limitUid} {
      allow read: if signedIn() && uid() == limitUid;
      allow create, update: if signedIn() && uid() == limitUid
          && request.resource.data.keys().hasOnly(['lastAt'])
          && request.resource.data.lastAt == request.time
          && (resource == null || resource.data.lastAt < request.time - duration.value(3, 's'));
    }

    // ---------- Team chat (Club hub) ----------
    // Only the squad (and admins) can read or post. A signed-in player is found through their
    // Discord profile id ("d<discordId>") or, for claimed profiles, their approved claim.
    function squadMember(pid, teamId) {
      return exists(/databases/$(database)/documents/players/$(pid))
          && playerDoc(pid).get('uid', '') == uid() && playerDoc(pid).get('teamId', '') == teamId;
    }
    // playerLinks/{uid} says which profile a sign-in belongs to. The browser writes it, and the rule
    // below only accepts it when that profile really has this uid, so it can't be faked.
    function inSquad(teamId) {
      return signedIn()
          && exists(/databases/$(database)/documents/playerLinks/$(uid()))
          && squadMember(get(/databases/$(database)/documents/playerLinks/$(uid())).data.playerId, teamId);
    }
    match /playerLinks/{linkUid} {
      allow read: if isAdmin() || (signedIn() && uid() == linkUid);
      allow create, update: if signedIn() && uid() == linkUid
          && request.resource.data.keys().hasOnly(['playerId'])
          && request.resource.data.playerId is string
          && exists(/databases/$(database)/documents/players/$(request.resource.data.playerId))
          && playerDoc(request.resource.data.playerId).get('uid', '') == uid();
      allow delete: if isAdmin() || (signedIn() && uid() == linkUid);
    }
    match /teams/{teamId}/chat/{messageId} {
      allow read: if isAdmin() || inSquad(teamId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['body', 'authorUid', 'authorPlayerId', 'createdAt'])
        && request.resource.data.body is string && request.resource.data.body.trim().size() > 0
        && request.resource.data.body.size() <= 500
        && noSlurs(request.resource.data.body)
        && request.resource.data.authorUid == uid() && request.resource.data.createdAt == request.time
        && squadMember(request.resource.data.authorPlayerId, teamId);
      allow delete: if isAdmin() || (signedIn() && (resource.data.authorUid == uid() || managesTeam(teamId)));
    }

    // ---------- Comments on team and player pages ----------
    // Anyone can read. Players with a profile post as themselves (≤500 characters), at most one
    // comment every 15 seconds: each post also stamps commentLimits/{uid} in the same save, and
    // that stamp can't be moved forward again until 15 seconds have passed.
    // The writer, the page's owner (the player, or the team's manager) and admins can delete.
    function validComment() {
      let d = request.resource.data;
      return signedIn()
          && d.keys().hasOnly(['body', 'authorUid', 'authorPlayerId', 'createdAt', 'updatedBy', 'updatedAt'])
          && d.keys().hasAll(['body', 'authorUid', 'authorPlayerId', 'createdAt'])
          && d.body is string && d.body.trim().size() > 0 && d.body.size() <= 500 && noSlurs(d.body)
          && d.authorUid == uid() && d.createdAt == request.time && stampedByMe()
          && ownsPlayer(d.authorPlayerId)
          && getAfter(/databases/$(database)/documents/commentLimits/$(uid())).data.lastAt == request.time;
    }
    match /teams/{teamId}/comments/{commentId} {
      allow read: if true;
      allow create: if validComment() && teamDoc(teamId).get('status', 'approved') == 'approved';
      allow delete: if isAdmin() || (signedIn() && (resource.data.authorUid == uid() || managesTeam(teamId)));
    }
    match /players/{playerId}/comments/{commentId} {
      allow read: if true;
      allow create: if validComment() && exists(/databases/$(database)/documents/players/$(playerId));
      allow delete: if isAdmin() || (signedIn() && (resource.data.authorUid == uid() || ownsPlayer(playerId)));
    }
    match /commentLimits/{limitUid} {
      allow read: if signedIn() && uid() == limitUid;
      allow create, update: if signedIn() && uid() == limitUid
          && request.resource.data.keys().hasOnly(['lastAt', 'updatedBy', 'updatedAt'])
          && request.resource.data.lastAt == request.time && stampedByMe()
          && (resource == null || resource.data.lastAt < request.time - duration.value(15, 's'));
    }

    // ---------- Join requests (free agent -> team) ----------
    // One per player per team: id "<teamId>__<playerId>". The player asks; the team's manager accepts
    // (adding them in the same save, see players) or declines; the player can withdraw.
    match /joinRequests/{reqId} {
      allow read: if isAdmin();
      allow read: if signedIn() && resource.data.uid == uid();
      allow read: if managesTeam(resource.data.teamId);

      allow create, update: if signedIn() && stampedByMe()
        && reqId == request.resource.data.teamId + '__' + request.resource.data.playerId
        && request.resource.data.uid == uid()
        && ownsPlayer(request.resource.data.playerId)
        && playerDoc(request.resource.data.playerId).get('teamId', null) == null
        && teamDoc(request.resource.data.teamId).get('status', 'approved') == 'approved'
        && request.resource.data.status == 'pending'
        && (resource == null || resource.data.status != 'pending')
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 300))
        && request.resource.data.keys().hasOnly(['teamId', 'playerId', 'uid', 'message', 'status', 'createdAt', 'updatedBy', 'updatedAt']);

      allow update: if signedIn() && stampedByMe() && resource.data.status == 'pending' && (
        (resource.data.uid == uid() && request.resource.data.status == 'withdrawn'
          && changedOnly(['status', 'updatedBy', 'updatedAt']))
        || (managesTeam(resource.data.teamId) && request.resource.data.status in ['accepted', 'declined']
          && changedOnly(['status', 'updatedBy', 'updatedAt']))
        || (isAdmin() && changedOnly(['status', 'updatedBy', 'updatedAt'])));

      allow delete: if isAdmin();
    }

    // ---------- Signing offers (manager -> free agent) ----------
    match /offers/{offerId} {
      // (Written as separate lines so "offers I sent" and "offers to me" queries each match one.)
      allow read: if isAdmin();
      allow read: if signedIn() && resource.data.playerUid == uid();
      allow read: if signedIn() && resource.data.fromUid == uid();

      allow create: if signedIn() && stampedByMe()
        && request.resource.data.fromUid == uid()
        && managesTeam(request.resource.data.teamId)
        && request.resource.data.status == 'pending'
        && playerDoc(request.resource.data.playerId).get('teamId', null) == null
        && playerDoc(request.resource.data.playerId).get('uid', null) != null
        && request.resource.data.playerUid == playerDoc(request.resource.data.playerId).uid
        && request.resource.data.keys().hasOnly(['teamId', 'playerId', 'playerUid', 'fromUid', 'status', 'createdAt', 'updatedBy', 'updatedAt']);

      allow update: if signedIn() && stampedByMe() && resource.data.status == 'pending' && (
        (resource.data.playerUid == uid() && request.resource.data.status in ['accepted', 'declined']
          && changedOnly(['status', 'updatedBy', 'updatedAt']))
        || (resource.data.fromUid == uid() && request.resource.data.status == 'withdrawn'
          && changedOnly(['status', 'updatedBy', 'updatedAt']))
        || (isAdmin() && changedOnly(['status', 'updatedBy', 'updatedAt'])));

      allow delete: if isAdmin();
    }

    // ---------- Leave requests (player -> admin) ----------
    match /leaveRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == uid());

      allow create: if signedIn() && stampedByMe()
        && request.resource.data.uid == uid()
        && ownsPlayer(request.resource.data.playerId)
        && request.resource.data.teamId != null
        && playerDoc(request.resource.data.playerId).get('teamId', null) == request.resource.data.teamId
        && request.resource.data.status == 'pending'
        && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500))
        && request.resource.data.keys().hasOnly(['playerId', 'teamId', 'uid', 'reason', 'status', 'createdAt', 'updatedBy', 'updatedAt']);

      allow update: if (isAdmin() && stampedByMe())
        || (signedIn() && resource.data.uid == uid() && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled' && stampedByMe()
            && changedOnly(['status', 'updatedBy', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ---------- Profile claims (player -> admin). One per account: the doc id is the uid. ----------
    match /claims/{claimUid} {
      allow read: if isAdmin() || (signedIn() && claimUid == uid());

      allow create, update: if (isAdmin() && stampedByMe())
        || (signedIn() && claimUid == uid() && stampedByMe()
            && request.resource.data.status == 'pending'
            && request.resource.data.discordId == discordId()
            && playerDoc(request.resource.data.playerId).get('uid', null) == null
            && (resource == null || resource.data.status != 'approved')
            && request.resource.data.keys().hasOnly(['playerId', 'discordId', 'discordName', 'avatarUrl', 'status', 'createdAt', 'updatedBy', 'updatedAt']));

      allow delete: if isAdmin() || (signedIn() && claimUid == uid() && resource.data.status != 'approved');
    }

    // ---------- Site settings. Public. ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Who is an admin. A signed-in user may check their own entry only. ----------
    match /admins/{adminUid} {
      allow read: if signedIn() && uid() == adminUid;
      allow write: if false;
    }

    // ---------- Audit log: append-only, signed with the writer's own uid. Admins read it. ----------
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.by == uid()
        && request.resource.data.at == request.time
        && request.resource.data.action in ['create', 'update', 'delete'];
      allow update, delete: if false;
    }

    // Everything else is closed.
  }
}
