rules_version = '2';

// I<3JVO image uploads (Firebase Storage): team logos, player pictures, banners and backgrounds.
// Anyone can view. Only a team's manager (or the player themselves) can upload; admins can remove anything.
// Every upload gets a new file name, so files are never overwritten. GIFs are allowed everywhere.
//
//   teams/{teamId}/{logo|banner|background}/{file}
//   players/{playerId}/{avatar|banner|background}/{file}

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    // Same admin test as firestore.rules: listed in /admins, and a password sign-in or marked `discord: true`.
    function isAdmin() {
      return signedIn()
          && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
          && (request.auth.token.firebase.sign_in_provider == 'password'
              || firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('discord', false) == true);
    }
    // Size limits: pictures 2 MB, banners and match screenshots 4 MB, backgrounds 6 MB.
    // Everything is shrunk in the browser first (GIFs too, keeping the animation: gif-shrink.js),
    // so files stay small and cheap to serve. Same numbers as MEDIA.maxMb in public/js/media.js.
    function maxBytes(kind) {
      return (kind == 'background' ? 6 : (kind in ['banner', 'shot'] ? 4 : 2)) * 1024 * 1024;
    }
    function validImage(kind) {
      return request.resource.size <= maxBytes(kind)
          && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
    function managesTeam(teamId) {
      return signedIn()
          && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.managerUid == request.auth.uid;
    }
    function ownsPlayer(playerId) {
      return signedIn()
          && firestore.get(/databases/(default)/documents/players/$(playerId)).data.uid == request.auth.uid;
    }

    match /teams/{teamId}/{kind}/{file} {
      allow get: if true;
      allow create: if kind in ['logo', 'banner', 'background'] && validImage(kind)
                    && (isAdmin() || managesTeam(teamId));
      allow delete: if isAdmin() || managesTeam(teamId);
    }

    // The Discord bot's own account (listed in /pickupBots, password sign-in), like firestore.rules.
    function isPickupBot() {
      return signedIn()
          && request.auth.token.firebase.sign_in_provider == 'password'
          && firestore.exists(/databases/(default)/documents/pickupBots/$(request.auth.uid));
    }

    match /players/{playerId}/{kind}/{file} {
      allow get: if true;
      // "shot" = end-of-match screenshots attached to the player's result votes.
      allow create: if kind in ['avatar', 'banner', 'background', 'shot'] && validImage(kind)
                    && (isAdmin() || ownsPlayer(playerId));
      // Screenshots attached to a vote in a Discord match thread: the bot copies them here. They
      // come straight from Discord (not shrunk in a browser), so they may be up to 10 MB.
      allow create: if kind == 'shot' && isPickupBot()
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if isAdmin() || ownsPlayer(playerId);
    }

    // Everything else is closed.
  }
}
