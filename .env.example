# I<3JVO: every setting name used across the project, with placeholders.
# NOTHING in this file is real. Never commit real values; never paste secrets into chat.
# Where each value is kept and how to get it: HANDOVER.md §6.
#
# The WEBSITE (public/) needs no .env: its settings are in public/js/config.js and are public by
# design (Firebase web config, Discord client id, Worker URL). The security rules protect the data.

# ---------------------------------------------------------------------------------------------
# Cloudflare Worker (worker/): Discord sign-in + older images.
# Plain settings live in worker/wrangler.toml [vars]. The two SECRETS are stored on Cloudflare:
#   npx wrangler@4.146.0 secret put DISCORD_CLIENT_SECRET
#   Get-Content path\to\key.json -Raw | npx wrangler@4.146.0 secret put FIREBASE_SERVICE_ACCOUNT
# For a local Worker you can put them in worker/.dev.vars (git-ignored).
# ---------------------------------------------------------------------------------------------
DISCORD_CLIENT_ID=your-discord-app-client-id
DISCORD_CLIENT_SECRET=SECRET-from-discord-developer-portal-oauth2
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"SECRET"}
FIREBASE_PROJECT_ID=i-love-jvo
ALLOWED_ORIGINS=https://i-love-jvo.web.app,http://localhost:5000
# Local only: accept emulator sign-ins
DEV_MODE=1

# ---------------------------------------------------------------------------------------------
# Pickup bot (bot/): copy bot/.env.example to bot/.env, which has the full list with notes.
# The required ones:
# ---------------------------------------------------------------------------------------------
DISCORD_TOKEN=SECRET-bot-token-from-developer-portal
GUILD_ID=your-discord-server-id
PICKUP_CHANNEL_ID=your-pickup-channel-id
STORE=firebase
FIREBASE_BOT_EMAIL=pickup-bot@users.ilovejvo.com
FIREBASE_BOT_PASSWORD=SECRET-bot-firebase-password

# ---------------------------------------------------------------------------------------------
# Cloud Function (functions/): billing kill switch. No settings: it reads the project id from
# Google (GCLOUD_PROJECT) and is triggered by the budget's Pub/Sub topic "billing-killswitch".
# ---------------------------------------------------------------------------------------------
